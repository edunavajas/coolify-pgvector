# Usuario de PostgreSQL. Se crea en el primer arranque.
POSTGRES_USER=knowledge

# Contraseña del usuario anterior. DEBE cambiarse por una propia (Coolify puede generarla).
# Nunca subir un .env con la contraseña real al repositorio.
POSTGRES_PASSWORD=CHANGE_ME_overwrite_in_coolify

# Nombre de la base de datos que se crea en el primer arranque.
POSTGRES_DB=knowledge

# Puerto público OPCIONAL, solo para depuración local.
# Solo se usa si descomentas el bloque "ports" en docker-compose.yml.
# No es necesario para que n8n se conecte (va por la red interna de Coolify).
POSTGRES_DEBUG_PORT=5432
